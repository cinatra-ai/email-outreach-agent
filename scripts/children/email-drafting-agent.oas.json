      "component_type": "InputMessageNode",
      "id": "approval_gate",
      "name": "Review drafts",
      "metadata": {
        "cinatra": {
          "riskClass": "approval",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/email-drafting-agent:email-drafts-review",
          "a2uiSurfaceId": "email-drafting:review:input",
          "autoSkipWhenInputsPresent": false,
          "description": "Read the drafted emails, then approve, send them back for revision, or reject the run.",
          "inputMessageSchema": {
            "type": "object",
            "x-renderer": "@cinatra-ai/email-drafting-agent:email-drafts-review",
            "properties": {
              "draftBodyArtifacts": {
                "type": "array",
                "title": "Drafted emails",
                "x-artifact-kind": "@cinatra-ai/email:body",
                "x-artifact-read": "artifact_representation_get",
                "items": {
                  "type": "object"
                },
                "readOnly": true
              },
              "draftBundleRef": {
                "type": "string",

        },
        {
          "title": "reviewedBundle",
          "type": "object"
        },
        {
          "title": "reviewedDocument",
          "type": "string"
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "draft_update",
          "requiresApproval": false
        }
      }
    },
    "uuid_match": {
      "component_type": "PluginRegexNode",
      "id": "uuid_match",
      "name": "uuid_match",
      "metadata": {},
      "inputs": [

    "draft": {
      "component_type": "ApiNode",
      "id": "draft",
      "name": "Draft emails",
      "url": "{{CINATRA_BASE_URL}}/api/llm-bridge",
      "http_method": "POST",
      "data": {
        "system": "You are an email drafting agent.\n\nStep 1: Call objects_get with confirmedRecipientsRef to fetch the recipients list.\n\nStep 1b: For each entry of contextSlotBindings, call artifact_representation_get({ artifactId, representationRevisionId }) to read the pinned context the operator selected. Read the context ONLY through that road \u2014 never reach for the parent run's slot or project. Skip an entry the road refuses.\n\nStep 2: Generate exactly one personalized initial outreach email per recipient using offeringCompanyWebsite, callToAction, and senderName as context.\n\nStep 3 \u2014 CRITICAL: Call objects_save BEFORE returning any JSON. Use exactly this structure:\n  objects_save({\n    typeHint: \"@cinatra-ai/campaigns:email-draft-bundle\",\n    rawData: {\n      cinatra_agent_run_id: \"<agent_run_id input>\",\n      drafts: [\n        { recipientEmail: \"...\", subject: \"...\", body: \"...\", status: \"draft\" }\n      ]\n    }\n  })\n\nStep 4: Return ONLY this JSON using the object ID returned by objects_save: {\"draftBundleRef\":\"<objectId returned by objects_save>\",\"draftBundleTitle\":\"<short title, e.g. Email draft bundle (N recipients)>\",\"draftBodyArtifacts\":[{\"artifactId\":\"<id>\",\"representationRevisionId\":\"<revision>\"}],\"summary\":\"<one sentence summary>\"}. draftBodyArtifacts lists one @cinatra-ai/email:body artifact per draft, in recipient order, so the review screen can display the bodies themselves.\n\nDo NOT return draftBundleRef without completing Step 3. Never skip objects_save. Do not send emails \u2014 this agent only drafts.",
        "user": "Execute the email drafting task now and return the result as JSON.\nInputs:\n- offeringCompanyWebsite: {{ offeringCompanyWebsite }}\n- callToAction: {{ callToAction }}\n- senderName: {{ senderName }}\n- confirmedRecipientsRef: {{ confirmedRecipientsRef }}\n- contextSlotBindings: {{ contextSlotBindings }}\n- campaignId: {{ campaignId }}",
        "agent_id": "email-drafting",
        "agent_run_id": "{{ agent_run_id }}",
        "cinatra_llm": {
          "preferredProvider": "openai",
          "preferredModel": "gpt-5.5"
        }
      },
      "outputs": [
        {
          "title": "draftBundleRef",
          "type": "string",
          "json_schema": {
            "format": "uuid"
          }
        },
        {
          "title": "draftBodyArtifacts",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "representationRevisionId": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "title": "draftBundleTitle",
          "type": "string"
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "draft_create",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/email-drafting-agent:output",
          "a2uiSurfaceId": "email-drafting:step-1:output"
        }
      },
      "inputs": [
        {
          "title": "agent_run_id",
          "type": "string",
          "default": ""
        },
        {
          "title": "offeringCompanyWebsite",
          "type": "string",
          "default": ""
        },
        {
          "title": "callToAction",
          "type": "string",
          "default": ""
        },
        {
          "title": "senderName",
          "type": "string",
          "default": ""
        },
        {
          "title": "confirmedRecipientsRef",
          "type": "string",
          "default": ""
        },
        {
          "title": "contextSlotBindings",
          "type": "array",
          "default": [],
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "campaignId",
          "type": "string",
          "default": ""
        }
      ]
    },
    "drafting_summary": {
      "component_type": "OutputMessageNode",
      "id": "drafting_summary",
      "name": "Drafting result",
      "inputs": [
        {
          "title": "reviewedBundle",
          "type": "object",
          "default": {}
        }
      ],
      "message": "{# pyagentspec-input-hint (do not remove): {{ reviewedBundle }} #}{% if not reviewedBundle or not reviewedBundle.drafts %}No emails were drafted in this run: there were no recipients to write to, or no draft could be written for them.{% else %}{{ reviewedBundle.drafts | length }} email drafts were reviewed and saved.{% endif %}",
      "metadata": {
        "cinatra": {
          "purpose": "plain-language-drafting-ending"
        }
      }
    },
    "end": {
      "component_type": "EndNode",
      "id": "end",
      "name": "End",
      "outputs": [
        {
          "title": "draftBundle",
          "type": "object",
          "default": {}
        },
        {
          "title": "draftBundleTitle",
          "type": "string",
          "default": ""
        },
        {
          "title": "draftBundleDocument",
          "type": "string",
          "cinatra": {
            "artifact": {
              "extension": "@cinatra-ai/email-artifacts",
              "objectTypeId": "@cinatra-ai/email:body",
              "contentFrom": "draftBundleDocument",
              "declaredMime": "text/markdown",
              "titleFrom": "draftBundleTitle"
            }
          },
          "default": ""
        },
        {
          "title": "userResponse",
          "type": "string",
          "default": ""
        },
        {
          "title": "draftBundleRef",
          "type": "string",
          "json_schema": {
            "format": "uuid"
          },
          "default": ""
        }
      ]
    },
